#!/bin/sh
# Вызывается opkg после установки и обновления.
[ -n "$IPKG_INSTROOT" ] && exit 0
export PATH=/opt/sbin:/opt/bin:/usr/sbin:/usr/bin:/sbin:/bin

CONF=/opt/etc/xsub/config.json

# Версии до 0.3.1 писали журнал на накопитель; теперь он в оперативной памяти (/tmp).
if ! grep -q '/opt/var/log/xsub' "$CONF" 2>/dev/null; then
  rm -f /opt/var/log/xsub.log /opt/var/log/xsub.log.old /opt/var/log/xsub.out
fi

FIRST=0
if [ ! -f "$CONF" ]; then
  FIRST=1
  /opt/sbin/xsub -init -config "$CONF" > /tmp/xsub-init.txt 2>&1
fi

if [ ! -x /opt/sbin/xray ]; then
  echo "xsub: не найден /opt/sbin/xray — установите XKeen с ядром Xray (xkeen -xray)."
fi

# Пакеты объявлены как "Architecture: all", поэтому opkg не мешает поставить сборку
# для чужой архитектуры: файл встанет, а запускаться не будет. Проверяем сразу,
# пока это видно в выводе установки, а не через неделю по неработающему сторожу.
VER=$(/opt/sbin/xsub -version 2>/dev/null)
if [ -z "$VER" ]; then
  echo
  echo "xsub: установленный /opt/sbin/xsub не запускается на этом роутере."
  echo "      Скорее всего, пакет собран для другой архитектуры (здесь $(uname -m))."
  echo "      Поставьте подходящий — install.sh определит её сам:"
  echo "        curl -fsSL https://raw.githubusercontent.com/OWNER/xsub/main/install.sh | sh"
  echo
  exit 0
fi

# Присмотр за процессом: на роутере xsub некому поднять, если он всё-таки упадёт.
# Раз в пять минут cron проверяет и запускает заново. Нет cron — шаг пропускается.
if command -v crond >/dev/null 2>&1; then
  CRON=/opt/etc/crontabs/root
  mkdir -p /opt/etc/crontabs
  touch "$CRON"
  if ! grep -q 'S99xsub start' "$CRON"; then
    echo '*/5 * * * * /opt/etc/init.d/S99xsub status >/dev/null 2>&1 || /opt/etc/init.d/S99xsub start >/dev/null 2>&1' >> "$CRON"
    [ -x /opt/etc/init.d/S10cron ] && /opt/etc/init.d/S10cron restart >/dev/null 2>&1
  fi
fi

/opt/etc/init.d/S99xsub restart >/dev/null 2>&1

IP=$(ip -4 addr show br0 2>/dev/null | awk '/inet /{split($2,a,"/"); print a[1]; exit}')
[ -n "$IP" ] || IP="<IP-роутера>"

echo
if [ "$FIRST" = 1 ]; then
  echo "xsub установлен."
  echo "  Веб-страница: http://$IP:8099/"
  grep -E '^(Логин|Пароль)' /tmp/xsub-init.txt | sed 's/^/  /'
  echo "  Откройте страницу и добавьте ссылку на подписку."
  rm -f /tmp/xsub-init.txt
else
  echo "xsub обновлён: $VER. Веб-страница: http://$IP:8099/"
fi
exit 0
